# Splice API Environment Dashboard

# 1. API Core
SPLICE_API_VERSION=0.1.0
SPLICE_ENV=local
SPLICE_LOG_LEVEL=INFO
SPLICE_LOG_DIR=logs
SPLICE_LOG_FILE_NAME=splice-api.log
SPLICE_LOG_FILE_MAX_BYTES=10485760
SPLICE_LOG_FILE_BACKUP_COUNT=5

# 2. Authentication Secrets
SPLICE_AUTH_ACCESS_SECRET=replace-with-strong-auth-secret

# 3. Email Config (Mailtrap Recommended for Dev)
# Create a free account at mailtrap.io for these credentials
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=0ccce1863f5cd0
SMTP_PASSWORD=YOUR_PASSWORD_HERE
SMTP_FROM_EMAIL=system@splice.local
