{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splice.local/schemas/error-response.v1.schema.json",
  "title": "ErrorResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "correlationId"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    }
  }
}
