{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fileeaters.local/schemas/event-envelope.v1.schema.json",
  "title": "EventEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventName",
    "eventVersion",
    "eventId",
    "occurredAt",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "properties": {
    "eventName": {
      "type": "string",
      "minLength": 1
    },
    "eventVersion": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
