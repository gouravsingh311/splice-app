# App Root Directory Env Variables (example)

# ── App ─────────────────────────────────────────────────
SPLICE_ENV=local
SPLICE_APP_NAME=splice-app
SPLICE_APP_VERSION=1.0.0
SPLICE_HEALTH_PORT=4815
SPLICE_ENABLE_HEALTH_SERVER=true
SPLICE_LOG_LEVEL=debug
SPLICE_API_BASE_URL=http://127.0.0.1:8000
SPLICE_API_PORT=8000

# ── OpenAI ──────────────────────────────────────────────
# Local API key for AI-powered features. Handle securely!
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Privacy / Presenter Mode ────────────────────────────
# Default state of the mask (1 = enabled, 0 = disabled)
SPLICE_PRESENTER_MODE=1

# ── Database ─────────────────────────────────────────────
# SQLite — auto-created on first boot
SPLICE_DB_PATH=./data/splice.db

# ── Auth ─────────────────────────────────────────────────
SPLICE_AUTH_ACCESS_SECRET=replace-with-strong-auth-secret
SPLICE_INTERNAL_API_TOKEN=replace-with-strong-internal-token

# ── Airtable ────────────────────────────────────────────
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxxxxxxxxx
# Optional — if omitted, app auto-creates a base named "FileEaters Splice"
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXX

# ── Dropbox ─────────────────────────────────────────────
# Get token via: bash scripts/get-dropbox-token.sh
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=
DROPBOX_ACCESS_TOKEN=sl.xxxxxxxxxxxxxxxxxx
DROPBOX_DELIVERY_FOLDER=/Splice Deliveries

# ── Email (SMTP) ─────────────────────────────────────────
# Dev: sign up at mailtrap.io and copy your sandbox credentials
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=dev@fileeaters.local

# ── Dev flags ────────────────────────────────────────────
# Set to 1 to seed default local auth users:
# admin@fileeaters.local / AdminPass123!
# reviewer@fileeaters.local / ReviewerPass123!
# creator@fileeaters.local / CreatorPass123!
SPLICE_SEED_DEFAULT_USERS=1
