{
  "name": "splice-app",
  "version": "1.0.0",
  "description": "Baseline Electron app with Tailwind CSS and Flowbite.",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node -e \"const major = Number(process.versions.node.split('.')[0]); if (major < 20) { console.error('Node 20+ required. Current: ' + process.versions.node); process.exit(1); }\"",
    "postinstall": "node -e \"require('better-sqlite3'); console.log('better-sqlite3 OK')\"",
    "bootstrap": "bash ./scripts/bootstrap.sh",
    "bootstrap:backend": "node ./scripts/backend-bootstrap.js",
    "build:python": "bash scripts/build-python.sh",
    "build:css": "node ./scripts/tailwind/run-tailwind.js",
    "dev": "concurrently -k \"npm:dev:css\" \"npm:dev:electron\"",
    "dev:css": "node ./scripts/tailwind/run-tailwind.js --watch",
    "dev:electron": "electron .",
    "predev:electron": "npm run bootstrap:backend",
    "dist": "npm run build:python && npx electron-builder",
    "dist:mac": "npm run build:python && npx electron-builder --mac",
    "dist:win": "npm run build:python && npx electron-builder --win",
    "lint": "node ./scripts/lint/run.js",
    "predev": "npm run build:css",
    "security:deps": "npm audit --audit-level=high",
    "security:secrets": "node ./scripts/security-checks.js",
    "smoke:start": "node ./scripts/smoke/startup-smoke.js",
    "prestart": "npm run bootstrap:backend",
    "start": "npm run build:css && electron .",
    "test": "node --test || npx -y node@20 --test",
    "test:ui-stack": "node ./scripts/guards/ui-stack-guard.js",
    "parity:capture:reference": "npx -y node@20 ./scripts/parity/capture-reference.js",
    "parity:capture:local": "npx -y node@20 ./scripts/parity/capture-local.js",
    "parity:diff": "npx -y node@20 ./scripts/parity/visual-diff.js",
    "parity:run": "npm run parity:capture:local && npm run parity:diff",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "npx -y node@20 ./node_modules/@playwright/test/cli.js test",
    "test:e2e:core": "npx -y node@20 ./node_modules/@playwright/test/cli.js test --project=electron-ui --project=api-contract e2e/electron/auth/core.spec.ts e2e/electron/creator/dashboard.spec.ts e2e/electron/resilience/notifications-core.spec.ts e2e/electron/reviewer/decision-flow.spec.ts e2e/electron/creator/shell-navigation.spec.ts e2e/electron/creator/submission-lifecycle.spec.ts e2e/api/contracts/core-auth-audit-state.spec.ts e2e/api/contracts/notifications-jobs-scheduling.spec.ts e2e/api/contracts/negative-contract-envelopes.spec.ts",
    "test:e2e:extended": "npx -y node@20 ./node_modules/@playwright/test/cli.js test --project=electron-ui e2e/electron/admin/policy-feedback.spec.ts e2e/electron/auth/session-edge.spec.ts e2e/electron/resilience/degraded-recovery.spec.ts e2e/electron/accessibility/notifications-dropdown.spec.ts e2e/electron/resilience/durability.spec.ts e2e/electron/resilience/notifications-resilience.spec.ts e2e/electron/creator/qc-routing-regression.spec.ts e2e/electron/creator/airtable-qc-remediation.spec.ts e2e/electron/admin/ops-notifications-ui.spec.ts",
    "test:e2e:real-smoke": "RUN_REAL_SMOKE=1 node ./scripts/testing/e2e-stub-guard.js && RUN_REAL_SMOKE=1 npx -y node@20 ./node_modules/@playwright/test/cli.js test --project=electron-ui e2e/electron/cross-role/smoke-lifecycle.spec.ts",
    "test:e2e:stub-guard": "node ./scripts/testing/e2e-stub-guard.js",
    "test:e2e:headed": "npx -y node@20 ./node_modules/@playwright/test/cli.js test --headed",
    "test:e2e:install": "npx -y node@20 ./node_modules/playwright/cli.js install chromium",
    "visual:baseline:capture": "npx -y node@20 ./scripts/testing/capture-app-visual-baseline.js",
    "visual:baseline:diff": "npx -y node@20 ./scripts/testing/diff-app-visual-baseline.js",
    "visual:baseline:verify": "npm run visual:baseline:capture && npm run visual:baseline:diff",
    "demo:capture": "DEMO_MEDIA_CAPTURE_MODE=master npx -y node@20 ./node_modules/@playwright/test/cli.js test --config=playwright.demo.config.ts --project=electron-demo-video --workers=1 e2e/electron/media/demo-capture.spec.ts",
    "demo:video:silent": "node ./scripts/demo-media/render-videos.js silent",
    "demo:video:voiceover": "node ./scripts/demo-media/render-videos.js voiceover",
    "demo:screenshots": "DEMO_MEDIA_CAPTURE_MODE=screenshots npx -y node@20 ./node_modules/@playwright/test/cli.js test --config=playwright.demo.config.ts --project=electron-demo-stills --workers=1 e2e/electron/media/demo-capture.spec.ts",
    "demo:all": "npm run demo:capture && npm run demo:video:silent && npm run demo:video:voiceover"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@storybook/addon-essentials": "^7.6.20",
    "@storybook/html-vite": "^7.6.20",
    "@tailwindcss/cli": "^4.0.1",
    "@tailwindcss/postcss": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^40.6.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "storybook": "^7.6.20",
    "tailwindcss": "^4.0.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "flowbite": "^4.0.1",
    "zod": "^4.3.6"
  }
}
